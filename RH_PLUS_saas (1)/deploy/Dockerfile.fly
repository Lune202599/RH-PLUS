# RH PLUS — image pour Fly.io
# Différences avec deploy/Dockerfile (VPS/Docker) : le conteneur démarre en root
# uniquement pour s'approprier le volume monté sur /data (Fly crée les volumes en
# root), puis abandonne immédiatement ses privilèges pour le compte « node ».
FROM node:20-slim

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends gosu ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY . .

ENV NODE_ENV=production \
    RHPLUS_DATA_DIR=/data \
    PORT=3000
EXPOSE 3000

COPY deploy/fly-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

HEALTHCHECK --interval=30s --timeout=4s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
